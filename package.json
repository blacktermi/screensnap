{
  "name": "screensnap",
  "version": "0.1.0",
  "description": "A powerful, open-source screen capture and recording tool for macOS — CleanShot X alternative built with Electron, React, TypeScript, and Swift native addons.",
  "main": "dist/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "Tribal Enterprises",
  "repository": {
    "type": "git",
    "url": "https://github.com/tribal-enterprises/screensnap.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -k -n main,renderer -c blue,green \"pnpm dev:main\" \"pnpm dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "pnpm build:renderer && pnpm build:main && pnpm build:preload",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:native": "cd src/native && swift build -c release",
    "start": "pnpm build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.{ts,tsx}' --report-unused-disable-directives",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "build:dmg": "pnpm build && electron-builder --mac",
    "clean": "rm -rf dist out node_modules/.cache coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3",
    "i18next": "^24.2.2",
    "react-i18next": "^15.4.1",
    "fabric": "^6.5.3",
    "better-sqlite3": "^11.8.1",
    "electron-store": "^10.0.0",
    "ffmpeg-static": "^5.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^3.2.0",
    "vite": "^6.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vitest": "^3.0.7",
    "typescript": "^5.7.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.21.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2"
  }
}
